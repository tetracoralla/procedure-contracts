{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:procedure:structured-data.preflight:v0.1:input",
  "type": "object",
  "additionalProperties": false,
  "required": ["path"],
  "properties": {
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sample_rows": { "type": "integer", "minimum": 0, "maximum": 100, "default": 5 },
    "format": { "enum": ["json", "jsonl", "csv", "tsv", "yaml", "parquet"] },
    "select": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "kind": { "enum": ["tree", "table"] },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["quick", "standard", "deep"], "default": "standard" },
        "hash": { "enum": ["none", "sha256"], "default": "sha256" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "object", "minProperties": 1 },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/assertion" }
        }
      },
      "anyOf": [{ "required": ["schema"] }, { "required": ["assertions"] }]
    }
  },
  "$defs": {
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "field"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "enum": ["field_exists", "not_null"] },
            "field": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "unique" },
            "field": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          },
          "oneOf": [{ "required": ["field"] }, { "required": ["fields"] }]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "row_count" },
            "eq": { "type": "integer", "minimum": 0 },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          },
          "anyOf": [{ "required": ["eq"] }, { "required": ["min"] }, { "required": ["max"] }]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "field", "is"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "type": { "const": "type" },
            "field": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "is": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        }
      ]
    }
  }
}
