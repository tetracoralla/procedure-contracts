{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:procedure:structured-data.preflight:v0.1:output",
  "type": "object",
  "additionalProperties": false,
  "required": ["readiness", "file", "data"],
  "properties": {
    "readiness": { "enum": ["ready", "constraints-failed"] },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size_bytes", "media_type", "format", "confidence", "parseable", "structured_format"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "format": { "type": "string", "minLength": 1, "maxLength": 128 },
        "confidence": { "enum": ["exact", "high", "probable", "unknown"] },
        "parseable": { "const": true },
        "structured_format": { "enum": ["json", "jsonl", "csv", "tsv", "yaml", "toml", "xml", "svg"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "shape", "sample"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "bytes"],
          "properties": {
            "format": { "enum": ["json", "jsonl", "csv", "tsv", "yaml", "parquet"] },
            "bytes": { "type": "integer", "minimum": 0 }
          }
        },
        "shape": { "$ref": "#/$defs/shape" },
        "sample": true
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "schema_validation", "assertions"],
      "properties": {
        "valid": { "type": "boolean" },
        "schema_validation": { "type": ["object", "null"] },
        "assertions": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "status", "details"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 200 },
              "type": { "enum": ["field_exists", "not_null", "unique", "row_count", "type"] },
              "status": { "enum": ["passed", "failed"] },
              "details": { "type": "object" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fieldProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "nullable": { "type": "boolean" },
        "types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "missing_count": { "type": "integer", "minimum": 0 },
        "null_count": { "type": "integer", "minimum": 0 },
        "field_count": { "type": "integer", "minimum": 0 },
        "fields": { "type": "object", "maxProperties": 1000, "additionalProperties": { "$ref": "#/$defs/fieldProfile" } },
        "fields_truncated": { "type": "boolean" },
        "nested_truncated": { "type": "boolean" },
        "items_min": { "type": "integer", "minimum": 0 },
        "items_max": { "type": "integer", "minimum": 0 },
        "items": { "$ref": "#/$defs/fieldProfile" }
      }
    },
    "recordSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "select", "selectable", "rows", "columns", "fields"],
      "properties": {
        "path": { "type": "string" },
        "select": { "type": ["string", "null"] },
        "selectable": { "type": "boolean" },
        "rows": { "type": "integer", "minimum": 0 },
        "columns": { "type": "integer", "minimum": 0 },
        "fields": { "type": "object", "maxProperties": 1000, "additionalProperties": { "$ref": "#/$defs/fieldProfile" } },
        "fields_truncated": { "type": "boolean" }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["tree", "table"] },
        "type": { "type": "string" },
        "rows": { "type": "integer", "minimum": 0 },
        "columns": { "type": "integer", "minimum": 0 },
        "items": { "type": "integer", "minimum": 0 },
        "field_count": { "type": "integer", "minimum": 0 },
        "fields": { "type": "object", "maxProperties": 1000, "additionalProperties": { "$ref": "#/$defs/fieldProfile" } },
        "fields_truncated": { "type": "boolean" },
        "record_sets": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/recordSet" } },
        "record_sets_truncated": { "type": "boolean" },
        "sample_truncated": { "type": "boolean" }
      }
    }
  }
}
